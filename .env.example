# WHOOP Developer application (server-only; never expose these in client code)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/integrations/whoop/callback

# Club production access and the deliberate owner-only catalogue bootstrap are
# independent server-side gates. Keep both disabled until their reviewed rollout.
R12_CLUB_SCHEMA_ENABLED=false
R12_CLUB_CATALOGUE_BOOTSTRAP_ENABLED=false

# Server-only HMAC key binding a shared Club station to the staff member who
# unlocked it. Generate a random value of at least 32 bytes; never expose it to
# NEXT_PUBLIC_* variables.
R12_CLUB_STATION_SESSION_SECRET=
# Shared-station inactivity lock; defaults to 5 minutes.
R12_CLUB_STATION_TIMEOUT_MINUTES=5

# Restrict the account-deletion processing queue to named platform privacy
# operators by their existing Supabase Auth user UUIDs (comma-separated).
# Leave blank to keep operator access disabled; never grant all gym staff.
R12_PRIVACY_OPERATOR_USER_IDS=
