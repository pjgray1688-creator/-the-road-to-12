# WHOOP Developer application (server-only; never expose these in client code)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/integrations/whoop/callback

# Club production access and the deliberate owner-only catalogue bootstrap are
# independent server-side gates. Keep both disabled until their reviewed rollout.
R12_CLUB_SCHEMA_ENABLED=false
R12_CLUB_CATALOGUE_BOOTSTRAP_ENABLED=false

# Server-only HMAC key binding a shared Club station to the staff member who
# unlocked it. Generate a random value of at least 32 bytes; never expose it to
# NEXT_PUBLIC_* variables.
R12_CLUB_STATION_SESSION_SECRET=
# Shared-station inactivity lock; defaults to 5 minutes.
R12_CLUB_STATION_TIMEOUT_MINUTES=5

# Server-only JSON object mapping explicitly authorised Supabase Auth UUIDs to
# real operator names, for example {"uuid":"Alex Smith"}. At least two named
# people are required. Leave blank to fail closed; never grant all gym staff.
R12_PRIVACY_OPERATOR_ALLOWLIST=
# 32 random bytes encoded as base64. Encrypts the verified completion address
# while a request is open; rotate only through the documented recovery process.
R12_PRIVACY_NOTIFICATION_ENCRYPTION_KEY=
# Keep false until migration preflight and disposable-project end-to-end
# verification are signed off. Review/approval can operate while execution is off.
R12_ACCOUNT_DELETION_EXECUTION_ENABLED=false
R12_EMAIL_FROM_PRIVACY=privacy@r12.live
R12_EMAIL_FROM_NAME_PRIVACY=R12
